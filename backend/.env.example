# KULTR Backend - Environment Configuration Template
# Copy this file to '.env' and fill in your details. Never commit '.env' to version control!

# Server Configuration
ENVIRONMENT=development
PORT=10000
HOST=0.0.0.0

# Database Configuration (Supabase PostgreSQL Connection URI)
# Locally, you can use SQLite: sqlite+aiosqlite:///./kultr_local.db
# In production, use your Supabase pooled connection string:
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# CORS Configuration (Set to your specific Vercel frontend URL in production)
FRONTEND_ORIGIN=http://localhost:5173
